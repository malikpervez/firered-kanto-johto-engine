+static const struct FriendsCamp *FindCamp(u8 mapNum, u8 mapGroup)
+{
+    u32 i;
+    for (i = 0; i < ARRAY_COUNT(sCamps); i++)
+        if (sCamps[i].map == ((mapGroup << 8) | mapNum))
+            return &sCamps[i];
+    return NULL;
+}

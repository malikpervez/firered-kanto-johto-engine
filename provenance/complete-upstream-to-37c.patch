+struct KantoSeamSecondaryClock
+{
+    void (*initializer)(void);
+    void (*step)(u16);
+    u16 counterMax;
+};
+static const struct KantoSeamSecondaryClock sKantoSeamSecondaryClocks[] = {
+    { InitTilesetAnim_CeruleanCity_Hns, TilesetAnim_CeruleanCity_Hns, 120 },
+    { InitTilesetAnim_CeladonCity_Hns, TilesetAnim_CeladonCity_Hns, 120 },
+    { InitTilesetAnim_CeladonCity, TilesetAnim_CeladonCity, 120 },
+};
+static const struct KantoSeamSecondaryClock *KantoSeam_FindSecondaryClock(void)
+{
+    u32 i;
+    const struct Tileset *tileset = gMapHeader.mapLayout->secondaryTileset;
+    if (tileset != NULL)
+        for (i = 0; i < ARRAY_COUNT(sKantoSeamSecondaryClocks); i++)
+            if (tileset->callback == sKantoSeamSecondaryClocks[i].initializer)
+                return &sKantoSeamSecondaryClocks[i];
+    return NULL;
+}
+static void KantoSeam_InitSecondaryAnimation(const struct KantoSeam *seam)
+{
+    if (seam != NULL && seam->animationCount != 0
+        && (sSecondaryTilesetAnimCallback == NULL || KantoSeam_FindSecondaryClock() != NULL))
+    {
+        // The exact source allocator verifies every source period divides this
+        // bounded u16 LCM and the unchanged 20-request animation buffer fits.
+        sSecondaryTilesetAnimCounterMax = seam->animationCounterMax;
+        sSecondaryTilesetAnimCallback = TilesetAnim_KantoSeam;
+    }
+}
+static void TilesetAnim_KantoSeam(u16 timer)
+{
+    const struct KantoSeam *seam = KantoSeam_Find(gMapHeader.mapLayout);
+    const struct KantoSeamSecondaryClock *clock = KantoSeam_FindSecondaryClock();
+    u32 i;
+    if (seam == NULL)
+        return;
+    if (clock != NULL)
+        clock->step(timer % clock->counterMax);
+    for (i = 0; i < seam->animationCount; i++)
+    {
+        const struct KantoSeamAnimation *animation = &seam->animations[i];
+        u16 sourceTimer = animation->sourceCounterMax != 0 ? timer % animation->sourceCounterMax : timer;
+        if (sourceTimer % animation->divisor == animation->phase)
+            AppendTilesetAnimToBuffer(animation->frames[(sourceTimer / animation->divisor) % animation->frameCount],
+                (u16 *)(BG_VRAM + TILE_OFFSET_4BPP(animation->destination)), animation->size);
+    }
+}
+#endif

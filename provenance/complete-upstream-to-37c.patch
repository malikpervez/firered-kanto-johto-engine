+	end
+
+B3_Johto_EventScript_GuideVisited::
+	msgbox B3_Johto_Text_GuideVisited
+	release
+	end
+
+B3_Johto_EventScript_GuideDone::
+	msgbox B3_Johto_Text_GuideDone

diff --git a/data/maps/PalletTown_Frlg/scripts.inc b/data/maps/PalletTown_Frlg/scripts.inc
index 47e6a2bcf0c373f0ac553f2f7fc0c945a055ab6b..dae064c9fd97df451876e27724045d6b8d8637b9 100644
--- a/data/maps/PalletTown_Frlg/scripts.inc
+++ b/data/maps/PalletTown_Frlg/scripts.inc
@@ -546,3 +546,72 @@ PalletTown_Text_PressStartToOpenMenuCopy::
 	.string "Press START to open the MENU!$"
 
 
+#ifdef FIRERED
+@ The actual Kanto game-clear event supplies Oak's post-League eligibility.
+B2_Pallet_EventScript_VisitJohto::
+	lock
+	faceplayer
+	goto_if_unset FLAG_SYS_GAME_CLEAR, B2_Pallet_EventScript_LeagueRequired
+	special Special_JohtoCampaignGetState
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_JohtoWestPassDirections
+	goto_if_lt JOHTO_VAR_NEWBARKTOWN_LABSTATE, 2, PalletTown_EventScript_JohtoWestPassDirections
+	msgbox B2_Pallet_Text_VisitJohto, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, B2_Pallet_EventScript_DeclineTravel
+	closemessage
+	special Special_JohtoCampaignInitialize
+	goto_if_eq VAR_RESULT, FALSE, B2_Pallet_EventScript_TravelUnavailable
+	warp MAP_NEW_BARK_TOWN_HNS, 5, 23
+	waitstate
+	releaseall
+	end
+
+B2_Pallet_EventScript_LeagueRequired::
+	msgbox B2_Pallet_Text_LeagueRequired, MSGBOX_DEFAULT
+	closemessage
+	release
+	end
+
+PalletTown_EventScript_JohtoWestPassDirections::
+	msgbox PalletTown_Text_JohtoWestPassDirections, MSGBOX_DEFAULT
+	closemessage
+	release
+	end
+
+B2_Pallet_EventScript_TravelUnavailable::
+	msgbox B2_Pallet_Text_TravelUnavailable, MSGBOX_DEFAULT
+	closemessage
+	release
+	end
+
+B2_Pallet_EventScript_DeclineTravel::
+	closemessage
+	release
+	end
+
+B2_Pallet_Text_VisitJohto::
+	.string "Heading back to NEW BARK TOWN?\p"
+	.string "I can arrange a quick return trip\n"
+	.string "now that you've made the journey.\p"
+	.string "Shall we travel to JOHTO?$"
+
+PalletTown_Text_JohtoWestPassDirections::
+	.string "Congratulations, CHAMPION!\p"
+	.string "To reach PROF.ELM, return to\n"
+	.string "INDIGO PLATEAU.\p"
+	.string "Take the road west of the LEAGUE.\n"
+	.string "It leads to the ROUTE 27 coast.\p"
+	.string "SURF west into NEW BARK TOWN.\n"
+	.string "PROF.ELM is expecting you!$"
+
+B2_Pallet_Text_LeagueRequired::
+	.string "First, challenge the KANTO LEAGUE.\p"
+	.string "PROF.OAK has a colleague he'd like\n"
+	.string "you to meet after your victory.$"
+
+B2_Pallet_Text_TravelUnavailable::
+	.string "The trip to JOHTO isn't available\n"
+	.string "right now. Please speak to\l"
+	.string "PROF.OAK again.$"
+#endif
+
+

 // Retrieve graphic information about the following pokemon, if any
+#ifdef FIRERED
+bool32 IsPikachuCompanionActive(void)
+{
+    // Native shared flag survives regional travel and older-save adoption.
+    // Derive presentation from existing progress; do not allocate or grant a mon.
+    return FlagGet(FLAG_SYS_POKEMON_GET);
+}
+
+// PC02: presentation-only bond from the trainer's existing saved travel count.
+// Older trainers adopt their current journey tone. This does not assert that
+// Pikachu witnessed earlier events, and never reads or changes an owned mon.
+u16 GetPikachuCompanionReaction(void)
+{
+    u32 steps = GetGameStat(GAME_STAT_STEPS);
+    u32 weather = GetCurrentWeather();
+    u32 music = GetCurrentMapMusic();
+    bool32 outdoors = MapHasNaturalLight(gMapHeader.mapType);
+
+    // Place/safety comes before affection. Even a devoted friend can be scared.
+    if (gMapHeader.regionMapSectionId == MAPSEC_POKEMON_TOWER
+     || gMapHeader.regionMapSectionId == JOHTO_MAPSEC_BURNED_TOWER)
+        return steps < PIKACHU_BOND_FRIENDLY_STEPS ? PIKACHU_REACTION_SCARED : PIKACHU_REACTION_REASSURED;
+    if (outdoors && weather == WEATHER_RAIN_THUNDERSTORM)
+        return steps < PIKACHU_BOND_DEVOTED_STEPS ? PIKACHU_REACTION_STARTLED : PIKACHU_REACTION_BRAVE;
+    if (gMapHeader.mapType == MAP_TYPE_UNDERGROUND)
+        return PIKACHU_REACTION_CAUTIOUS;
+    // These describe the room, never a claimed recent heal or battle victory.
+    if (music == MUS_POKE_CENTER || music == MUS_RG_POKE_CENTER || music == MUS_HG_POKE_CENTER)
+        return PIKACHU_REACTION_RELAXED;
+    if (music == MUS_GYM || music == MUS_RG_GYM || music == MUS_HG_GYM)
+        return PIKACHU_REACTION_EAGER;
+    if (outdoors && (weather == WEATHER_RAIN || weather == WEATHER_DOWNPOUR))
+        return PIKACHU_REACTION_RAIN;
+    if (outdoors && gTimeOfDay == TIME_NIGHT)
+        return PIKACHU_REACTION_SLEEPY;
+
+    // Talking alone cannot farm closeness. Native walking/save rules own steps.
+    if (steps < PIKACHU_BOND_FRIENDLY_STEPS)
+        return (Random() & 1) ? PIKACHU_REACTION_SHY : PIKACHU_REACTION_CURIOUS;
+    if (steps < PIKACHU_BOND_DEVOTED_STEPS)
+        return (Random() & 1) ? PIKACHU_REACTION_HAPPY : PIKACHU_REACTION_PLAYFUL;
+    return (Random() & 1) ? PIKACHU_REACTION_AFFECTIONATE : PIKACHU_REACTION_TRUSTING;
+}
+
+void Special_PikachuCompanionReaction(void)
+{
+    gSpecialVar_Result = GetPikachuCompanionReaction();
+}

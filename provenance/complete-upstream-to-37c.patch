+void FriendsScene_OnMapLoad(void)
+{
+    u32 i;
+    // Publish only an armed handoff on its actual destination. Both native
+    // ON_LOAD and ON_TRANSITION may run; preserve the phase until the fresh
+    // on-frame script consumes it. Unrelated map loads cannot replay the visit.
+    if (sFujiWarpPhase != 0)
+    {
+        gSpecialVar_0x8007 = FujiWarpHere(sFujiWarpPhase) ? sFujiWarpPhase : 0;
+        if (gSpecialVar_0x8007 == 0)
+        {
+            sFujiWarpPhase = 0;
+            sFujiContextValid = FALSE;
+        }
+    }
+    else
+    {
+        u16 map = (gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum;
+        sFujiContextValid = FALSE;
+        // These two audited maps do not own8007. Prevent an unrelated native
+        // special's stale1/2 from dispatching even an invalid resume. Every
+        // other map's special operands remain untouched.
+        if (map == MAP_LAVENDER_TOWN || map == MAP_LAVENDER_TOWN_VOLUNTEER_POKEMON_HOUSE)
+            gSpecialVar_0x8007 = 0;
+    }
+    // Called only by actual ON_LOAD/ON_TRANSITION map boundaries. Ordinary
+    // scene/menu/battle branches restore framing through the script helper.
+    FriendsCamera_OnMapLoad();
+    sAllowTransient = FALSE;
+    sMovementFault = 0;
+    sPreviousSpeaker = 0xFF;
+    sPreviousCrossing = 0;
+    if (FriendsStory_IsReady() && CurrentCamp() != NULL && gMapHeader.events != NULL)
+    {
+        // Supported older native6 snapshots have no appended Friends slots.
+        // Refresh exactly those seven ROM-owned slots, preserving every native
+        // prefix, native actor position, party, bag and unrelated saved field.
+        for (i = 0; i < gMapHeader.events->objectEventCount
+                && i < ARRAY_COUNT(gSaveBlock1Ptr->objectEventTemplates); i++)
+        {
+            const struct ObjectEventTemplate *rom = &gMapHeader.events->objectEvents[i];
+            struct ObjectEventTemplate *saved = &gSaveBlock1Ptr->objectEventTemplates[i];
+            if (rom->localId >= CurrentCamp()->firstLocalId && rom->localId < CurrentCamp()->firstLocalId + 7
+             && (saved->localId != rom->localId || saved->graphicsId != rom->graphicsId
+              || saved->x != rom->x || saved->y != rom->y || saved->elevation != rom->elevation))
+                *saved = *rom;
+        }
+    }
+    // Remove only our audited IDs on our own maps; never another actor.
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        struct ObjectEvent *o = &gObjectEvents[i];
+        const struct FriendsCamp *camp = FindCamp(o->mapNum, o->mapGroup);
+        if (o->active && camp != NULL
+         && ((o->localId >= camp->firstLocalId && o->localId < camp->firstLocalId + 7)
+          || (o->localId >= 227 && o->localId <= 230))
+         && !FriendsScene_ShouldSpawn(o->localId, o->mapNum, o->mapGroup))
+            RemoveObjectEventByLocalIdAndMap(o->localId, o->mapNum, o->mapGroup);
+    }
+}
+
+static void ShowHome(void)
+{
+    if (!FriendsVisuals_ShowHome())
+        sMovementFault = 5;
+}
+
+void Special_FriendsStoryStage(void)
+{
+    u16 scene = gSpecialVar_0x8004, beat = gSpecialVar_0x8005;
+    Script_RequestEffects(SCREFF_V1 | SCREFF_HARDWARE);
+    gSpecialVar_Result = FALSE;
+    if (CurrentCamp() == NULL || scene != FriendsStory_GetMapScene())
+        return;
+    if (beat == 0)
+    {
+        switch (scene)
+        {
+        case 1: ShowMon(SPECIES_GIRATINA_ALTERED, 3); break;
+        case 2: ShowPair(SPECIES_RATTATA, SPECIES_MANKEY); break;
+        case 3: ShowPair(SPECIES_JIGGLYPUFF, SPECIES_POLIWAG); break;
+        case 4: ShowPair(SPECIES_ODDISH, SPECIES_PSYDUCK); ShowMon(SPECIES_SPEAROW, 1); break;
+        case 5: ShowHuman(OBJ_EVENT_GFX_SAILOR_FRLG, 1); break;
+        case 6: ShowPair(SPECIES_POLIWAG, SPECIES_JIGGLYPUFF); break;
+        case 7: ShowPair(SPECIES_ODDISH, SPECIES_PARAS); break;
+        case 8:
+            if (((gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum) == MAP_LAVENDER_TOWN)
+                ShowHuman(OBJ_EVENT_GFX_MR_FUJI, 1);
+            break;
+        case 9: ShowPair(SPECIES_SLOWPOKE, SPECIES_KRABBY); ShowMon(SPECIES_GEODUDE, 1); break;
+        case 11: case 17: ShowHome(); break;
+        case 13: ShowPair(SPECIES_SLOWPOKE, SPECIES_PSYDUCK); break;
+        case 14: ShowHuman(OBJ_EVENT_GFX_SCIENTIST, 1); break;
+        case 15: ShowPair(SPECIES_PRIMEAPE, SPECIES_HOOTHOOT); break;
+        case 16: ShowMon(SPECIES_MURKROW, 0); break;
+        case 18: ShowHuman(OBJ_EVENT_GFX_FAT_MAN_FRLG, 1); ShowMon(SPECIES_PIDOVE, 0); break;
+        case 19: ShowPair(SPECIES_PRIMEAPE, SPECIES_JIGGLYPUFF); break;
+        case 20: ShowPair(SPECIES_WIGGLYTUFF, SPECIES_MURKROW); break;
+        case 21:
+            ShowHome(); ShowMon(SPECIES_GIRATINA_ALTERED, 3);
+            ShowPair(SPECIES_GOLDUCK, SPECIES_FURRET); break;
+        case 22: ShowMon(SPECIES_SLOWBRO, 0); break;
+        }
+    }
+    else if (scene == 1 && beat == 19)
+    {
+        Remove(230); Animate(221, MOVEMENT_ACTION_JUMP_IN_PLACE_DOWN);
+    }
+    else if (scene == 1 && beat == 90)
+    {
+        u8 i;
+        Remove(230);
+        for (i = 220; i < 227; i++) Remove(i);
+    }
+    else if ((scene == 2 && beat == 22) || (scene == 3 && beat == 19)
+          || (scene == 4 && beat == 25) || (scene == 7 && beat == 26)
+          || (scene == 9 && beat == 17) || (scene == 13 && beat == 21)
+          || (scene == 15 && beat == 23) || (scene == 16 && beat == 5))
+    {
+        // Animate only newly accepted partners, never recapture one that
+        // already belongs to a friend in the immediately preceding dialogue.
+        if (scene == 2 || scene == 3 || scene == 9 || scene == 16)
+            Animate(227, MOVEMENT_ACTION_ENTER_POKEBALL);
+        if (scene == 9 || scene == 13)
+            Animate(228, MOVEMENT_ACTION_ENTER_POKEBALL);
+        if (scene == 2 || scene == 4 || scene == 7 || scene == 9 || scene == 15)
+            Animate(229, MOVEMENT_ACTION_ENTER_POKEBALL);
+    }
+    else if (scene == 13 && beat == 8)
+        ShowMon(SPECIES_SENTRET, 1);
+    else if (scene == 8 && beat == 8)
+    {
+        ClearPartners();
+        if (((gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum) == MAP_LAVENDER_TOWN_VOLUNTEER_POKEMON_HOUSE)
+            ShowMon(SPECIES_MANKEY, 0);
+    }
+    else if (scene == 7 && beat == 22)
+        ShowHuman(OBJ_EVENT_GFX_FAT_MAN_FRLG, 1);
+    else if (scene == 16 && beat == 19)
+    {
+        ShowPair(SPECIES_PSYDUCK, SPECIES_PRIMEAPE);
+        Animate(227, MOVEMENT_ACTION_JUMP_IN_PLACE_DOWN);
+        Animate(229, MOVEMENT_ACTION_JUMP_IN_PLACE_DOWN);
+    }
+    else if ((scene == 11 && beat == 12) || (scene == 17 && beat == 17))
+    {
+        ShowMon(SPECIES_GIRATINA_ALTERED, 3);
+        FriendsVisuals_HideHome();
+    }
+    else if (scene == 21 && beat >= 30 && beat <= 36)
+    {
+        u8 pair = beat - 30;
+        if (pair == 0)
+        {
+            ShowHome();
+            ShowMon(SPECIES_GIRATINA_ALTERED, 3);
+        }
+        if (sPreviousCrossing != 0)
+            Remove(220 + sDepartureOrder[sPreviousCrossing - 1]);
+        ShowPair(sFinalPartners[pair][0], sFinalPartners[pair][1]);
+        Animate(227, MOVEMENT_ACTION_WALK_NORMAL_UP);
+        Animate(229, MOVEMENT_ACTION_WALK_NORMAL_UP);
+        Animate(220 + sDepartureOrder[pair], MOVEMENT_ACTION_WALK_NORMAL_UP);
+        sPreviousCrossing = pair + 1;
+    }
+    else if (scene == 21 && beat == 11)
+        ShowPair(SPECIES_RATICATE, SPECIES_SLOWBRO);
+    else if (scene == 21 && (beat == 20 || beat == 23))
+        ShowPair(SPECIES_PRIMEAPE, SPECIES_NOCTOWL);
+    else if (scene == 21 && beat == 37)
+    {
+        u8 i;
+        ClearPartners(); Remove(230); FriendsVisuals_HideHome();
+        for (i = 220; i < 227; i++) Remove(i);
+        sPreviousCrossing = 0;
+    }
+    gSpecialVar_Result = TRUE;
+}
+#endif
diff --git a/src/friends_story.c b/src/friends_story.c
new file mode 100644
index 0000000000000000000000000000000000000000..3bc82c3d51f2d3befb9bd8a8dd42ae7d32868282
--- /dev/null
+++ b/src/friends_story.c
@@ -0,0 +1,410 @@
+#include "global.h"
+
+#ifdef FIRERED
+#include "battle.h"
+#include "character_story.h"
+#include "event_data.h"
+#include "follower_npc.h"
+#include "friends_story.h"
+#include "johto_campaign.h"
+#include "load_save.h"
+#include "pokemon.h"
+#include "regional_save.h"
+#include "script.h"
+#include "constants/battle.h"
+#include "constants/character_story.h"
+#include "constants/friends_story.h"
+#include "constants/johto_ids.h"
+#include "constants/map_groups.h"
+#include "constants/species.h"
+
+STATIC_ASSERT(FRIENDS_STORY_FLAGS_FIRST > BUILD_FLAGS_END, FriendsAboveNativeFlags);
+STATIC_ASSERT(FRIENDS_STORY_FLAGS_LAST < ENGINE_FLAGS_START, FriendsBelowEngineFlags);
+STATIC_ASSERT(FRIENDS_STORY_FLAGS_FIRST > DAILY_FLAGS_END, FriendsOutsideDailyFlags);
+STATIC_ASSERT(FRIENDS_STORY_SEEN_LAST - FRIENDS_STORY_SEEN_FIRST + 1 == FRIENDS_STORY_SCENE_COUNT, FriendsSceneReceipts);
+STATIC_ASSERT(FRIENDS_STORY_TRAINER_LAST < MAX_TRAINERS_COUNT, FriendsTrainerFlagsAllocated);
+
+static u16 ReadBits(u16 first, u16 count)
+{
+    u16 value = 0, i;
+    for (i = 0; i < count; i++)
+        value |= FlagGet(first + i) << i;
+    return value;
+}
+
+static void WriteBits(u16 first, u16 count, u16 value)
+{
+    u16 i;
+    for (i = 0; i < count; i++)
+    {
+        if (value & (1 << i))
+            FlagSet(first + i);
+        else
+            FlagClear(first + i);
+    }
+}
+
+static bool8 Seen(u16 scene)
+{
+    return scene > 0 && scene <= FRIENDS_STORY_SCENE_COUNT
+        && FlagGet(FRIENDS_STORY_SEEN_FIRST + scene - 1);
+}
+
+static u16 CurrentMap(void)
+{
+    return (gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum;
+}
+
+bool8 FriendsStory_AllocationValid(void)
+{
+    u16 flag, stage, loss, scene;
+    if (gSaveBlock1Ptr == NULL)
+        return FALSE;
+    if (!FlagGet(FLAG_FRIENDS_STORY_ADOPTED))
+    {
+        for (flag = FRIENDS_STORY_FLAGS_FIRST; flag <= FRIENDS_STORY_FLAGS_LAST; flag++)
+            if (FlagGet(flag))
+                return FALSE;
+        return TRUE;
+    }
+    stage = ReadBits(FRIENDS_STORY_STAGE_FIRST, FRIENDS_STORY_STAGE_BITS);
+    loss = ReadBits(FRIENDS_STORY_LOSS_FIRST, FRIENDS_STORY_LOSS_BITS);
+    if (stage > FRIENDS_STORY_SCENE_COUNT || loss > 14)
+        return FALSE;
+    for (flag = FRIENDS_STORY_UNUSED_FIRST; flag <= FRIENDS_STORY_FLAGS_LAST; flag++)
+        if (FlagGet(flag))
+            return FALSE;
+    for (scene = 1; scene <= FRIENDS_STORY_SCENE_COUNT; scene++)
+        if (Seen(scene) && scene > stage)
+            return FALSE;
+    if ((FlagGet(FLAG_FRIENDS_FAREWELL_INVITED) && stage < 21)
+     || (Seen(21) && !FlagGet(FLAG_FRIENDS_FAREWELL_INVITED))
+     || (FlagGet(FLAG_FRIENDS_REUNION_ARMED) && !Seen(21))
+     || (stage == 22 && (!Seen(21) || !FlagGet(FLAG_FRIENDS_REUNION_ARMED))))
+        return FALSE;
+    return TRUE;
+}
+
+bool8 FriendsStory_IsReady(void)
+{
+    return gSaveBlock1Ptr != NULL && FlagGet(FLAG_FRIENDS_STORY_ADOPTED)
+        && FriendsStory_AllocationValid() && CharacterStory_IsReady();
+}
+
+bool8 FriendsStory_TryAdopt(void)
+{
+    u16 flag;
+    u16 previousResult;
+    if (FriendsStory_IsReady())
+        return TRUE;
+    // Reuse the existing supported native6 blank-window adoption first. Do not
+    // leave a hidden VAR_RESULT mutation in ordinary map loading.
+    if (!CharacterStory_IsReady())
+    {
+        previousResult = gSpecialVar_Result;
+        Special_CharacterStoryAdopt();
+        gSpecialVar_Result = previousResult;
+    }
+    if (gSaveBlock1Ptr == NULL || gSaveBlock3Ptr == NULL
+     || !CharacterStory_IsReady()
+     || !RegionalSave_FoundationValid((const u8 *)gSaveBlock3Ptr))
+        return FALSE;
+    // Accept only blank older allocation. Never erase unknown flags or awards.
+    for (flag = FRIENDS_STORY_FLAGS_FIRST; flag <= FRIENDS_STORY_FLAGS_LAST; flag++)
+        if (FlagGet(flag))
+            return FALSE;
+    for (flag = TRAINER_FLAGS_START + FRIENDS_STORY_TRAINER_FIRST;
+         flag <= TRAINER_FLAGS_START + FRIENDS_STORY_TRAINER_LAST; flag++)
+        if (FlagGet(flag))
+            return FALSE;
+    FlagSet(FLAG_FRIENDS_STORY_ADOPTED);
+    return TRUE;
+}
+
+void FriendsStory_NewGame(void)
+{
+    // Native clearing precedes this hook. No scene or battle is fabricated.
+    FlagSet(FLAG_FRIENDS_STORY_ADOPTED);
+}
+
+u16 FriendsStory_GetStage(void)
+{
+    return FriendsStory_IsReady()
+        ? ReadBits(FRIENDS_STORY_STAGE_FIRST, FRIENDS_STORY_STAGE_BITS) : 0;
+}
+
+static bool8 JohtoChampion(void)
+{
+    // Kanto's native game-clear flag cannot satisfy this independent milestone.
+    // Native GameClear/EnterHallOfFame write SYS_GAME_CLEAR only for Johto.
+    // The earlier scripted IS_CHAMPION flag is not the completed HOF receipt.
+    return JohtoCampaign_IsSeeded() && FlagGet(JOHTO_FLAG_SYS_GAME_CLEAR);
+}
+
+static bool8 FinalBattlesReady(void)
+{
+    return JohtoCampaign_IsSeeded() && FlagGet(JOHTO_FLAG_BADGE08_GET)
+        && VarGet(JOHTO_VAR_BLACKTHORN_CITY_STATE) >= 4;
+}
+
+bool8 FriendsStory_GetGate(u16 scene)
+{
+    if (gSaveBlock1Ptr == NULL || scene < 1 || scene > FRIENDS_STORY_SCENE_COUNT)
+        return FALSE;
+    if (scene <= 11 && FlagGet(FLAG_SYS_GAME_CLEAR))
+        return FALSE; // Late champions enter at the current chapter, not old fights.
+    if (scene >= 13 && scene <= 19 && JohtoChampion())
+        return FALSE;
+    switch (scene)
+    {
+    case 1: case 2: case 4: case 5: case 6: case 9:
+        return FlagGet(FLAG_SYS_POKEDEX_GET);
+    case 3:
+        return FlagGet(FLAG_GOT_FOSSIL_FROM_MT_MOON);
+    case 7:
+        return FlagGet(FLAG_HIDE_CELADON_ROCKETS);
+    case 8:
+        return FlagGet(FLAG_GOT_POKE_FLUTE);
+    case 10:
+        return FlagGet(FLAG_HIDE_SAFFRON_ROCKETS) && FlagGet(FLAG_GOT_MASTER_BALL_FROM_SILPH);
+    case 11:
+        return FlagGet(FLAG_HIDE_POKEMON_MANSION_B1F_SECRET_KEY);
+    case 12:
+        return FlagGet(FLAG_SYS_GAME_CLEAR) && VarGet(VAR_MAP_SCENE_PALLET_TOWN_OAK) >= 3;
+    case 13: case 14:
+        return CharacterStory_HasMetElm();
+    case 15:
+        return JohtoCampaign_IsSeeded() && VarGet(JOHTO_VAR_AZALEA_TOWN_STATE) >= 3
+            && FlagGet(JOHTO_FLAG_HIDE_AZALEA_TOWN_ROCKETS);
+    case 16:
+        return JohtoCampaign_IsSeeded()
+            && ((VarGet(JOHTO_VAR_GOLDENROD_CITY_STATE) >= 1 && VarGet(JOHTO_VAR_GOLDENROD_CITY_STATE) < 6)
+             || VarGet(JOHTO_VAR_GOLDENROD_CITY_STATE) >= 11);
+    case 17:
+        return JohtoCampaign_IsSeeded() && FlagGet(JOHTO_FLAG_RELEASED_BEASTS);
+    case 18:
+        return JohtoCampaign_IsSeeded() && FlagGet(JOHTO_FLAG_AMPHAROS_HEALED);
+    case 19:
+        return JohtoCampaign_IsSeeded() && VarGet(JOHTO_VAR_GOLDENROD_CITY_STATE) >= 11;
+    case 20:
+        return FinalBattlesReady();
+    case 21:
+        return JohtoChampion() && !Seen(21);
+    case 22:
+        return JohtoChampion() && Seen(21) && FlagGet(FLAG_FRIENDS_REUNION_ARMED);
+    }
+    return FALSE;
+}
+
+u16 FriendsStory_GetMapScene(void)
+{
+    if (gSaveBlock1Ptr == NULL)
+        return 0;
+    switch (CurrentMap())
+    {
+    case MAP_VIRIDIAN_CITY: return 1;
+    case MAP_ROUTE2: return 2;
+    case MAP_ROUTE4: return 3;
+    case MAP_CERULEAN_CITY: return 4;
+    case MAP_VERMILION_CITY: return 5;
+    case MAP_ROUTE11: return 6;
+    case MAP_CELADON_CITY: return 7;
+    case MAP_LAVENDER_TOWN: case MAP_LAVENDER_TOWN_VOLUNTEER_POKEMON_HOUSE: return 8;
+    case MAP_FUCHSIA_CITY: return 9;
+    case MAP_SAFFRON_CITY: return 10;
+    case MAP_CINNABAR_ISLAND: return 11;
+    case MAP_PALLET_TOWN: return 12;
+    case MAP_NEW_BARK_TOWN_HNS:
+        if (Seen(21))
+            return FlagGet(FLAG_FRIENDS_REUNION_ARMED) ? 22 : 0;
+        return FriendsStory_GetGate(21) ? 21 : 13;
+    case MAP_RUINS_OF_ALPH_OUTSIDE_HNS: return 14;
+    case MAP_AZALEA_TOWN_HNS: return 15;
+    case MAP_GOLDENROD_CITY_HNS: return FriendsStory_GetGate(19) ? 19 : 16;
+    case MAP_ECRUTEAK_CITY_HNS: return 17;
+    case MAP_OLIVINE_CITY_PORT_OUTSIDE_HNS: return 18;
+    case MAP_BLACKTHORN_CITY_HNS: return 20;
+    }
+    return 0;
+}
+
+void FriendsStory_OnMapLoad(void)
+{
+    u16 stage, scene;
+    // Native Continue restores the old map/cache before applying a pending
+    // Continue warp. That abandoned cache is not a visit. Its destination runs
+    // this hook after the native warp flag has been cleared.
+    if (UseContinueGameWarp() == TRUE)
+        return;
+    if (!FriendsStory_TryAdopt())
+        return;
+    // A cold Continue in the departure map never arms or respawns the group.
+    if (Seen(21) && CurrentMap() != MAP_NEW_BARK_TOWN_HNS)
+        FlagSet(FLAG_FRIENDS_REUNION_ARMED);
+    stage = FriendsStory_GetStage();
+    scene = FriendsStory_GetMapScene();
+    if (scene > stage && FriendsStory_GetGate(scene))
+        WriteBits(FRIENDS_STORY_STAGE_FIRST, FRIENDS_STORY_STAGE_BITS, scene);
+}
+
+static bool8 Here(u16 scene)
+{
+    return FriendsStory_IsReady() && scene == FriendsStory_GetStage()
+        && scene == FriendsStory_GetMapScene() && FriendsStory_GetGate(scene);
+}
+
+void FriendsStory_OnBattleOutcome(u16 trainerId, u32 outcome)
+{
+    if (!FriendsStory_IsReady() || trainerId < FRIENDS_STORY_TRAINER_FIRST
+     || trainerId > FRIENDS_STORY_TRAINER_LAST)
+        return;
+    // Called after an actual finished battle, before the native blackout path.
+    // Flee/forfeit/interrupted requests create no completed battle or follow-up.
+    if (outcome == B_OUTCOME_LOST || outcome == B_OUTCOME_DREW)
+        WriteBits(FRIENDS_STORY_LOSS_FIRST, FRIENDS_STORY_LOSS_BITS,
+            trainerId - FRIENDS_STORY_TRAINER_FIRST + 1);
+}
+
+void Special_FriendsStoryAdopt(void)
+{
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    gSpecialVar_Result = FriendsStory_TryAdopt();
+}
+
+void Special_FriendsStoryGetStage(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_GetStage();
+}
+
+void Special_FriendsStoryGetGate(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady() && FriendsStory_GetGate(gSpecialVar_0x8004);
+}
+
+void Special_FriendsStoryGetSeen(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady() && Seen(gSpecialVar_0x8004);
+}
+
+void Special_FriendsStoryBegin(void)
+{
+    u16 scene = gSpecialVar_0x8004;
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    FriendsStory_OnMapLoad();
+    gSpecialVar_Result = Here(scene) ? (Seen(scene) ? 2 : 1) : 0;
+}
+
+void Special_FriendsStoryMarkSeen(void)
+{
+    u16 scene = gSpecialVar_0x8004;
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    gSpecialVar_Result = FALSE;
+    if (scene == 21)
+    {
+        Special_FriendsStoryCompleteDeparture();
+        return;
+    }
+    if (Here(scene))
+    {
+        FlagSet(FRIENDS_STORY_SEEN_FIRST + scene - 1);
+        gSpecialVar_Result = TRUE;
+    }
+}
+
+void Special_FriendsStoryNeedsIntroduction(void)
+{
+    u16 scene;
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady();
+    for (scene = 1; scene <= FRIENDS_STORY_SCENE_COUNT; scene++)
+        if (Seen(scene))
+            gSpecialVar_Result = FALSE;
+}
+
+void Special_FriendsStoryCanFinalBattle(void)
+{
+    u16 stage = FriendsStory_GetStage();
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady() && FinalBattlesReady()
+        && (stage == 20 || stage == 21 || stage == 22) && Here(stage);
+}
+
+void Special_FriendsStoryCanBattle(void)
+{
+    static const u8 sEarlyScenes[] = {2, 3, 6, 6, 7, 9, 16};
+    u16 trainer = gSpecialVar_0x8004;
+    u16 stage = FriendsStory_GetStage();
+    u32 i;
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FALSE;
+    if (!FriendsStory_IsReady() || !Here(stage) || PlayerHasFollowerNPC()
+     || trainer < FRIENDS_STORY_TRAINER_FIRST || trainer > FRIENDS_STORY_TRAINER_LAST)
+        return;
+    if (trainer <= FRIENDS_STORY_EARLY_TRAINER_LAST)
+    {
+        if (stage != sEarlyScenes[trainer - FRIENDS_STORY_TRAINER_FIRST])
+            return;
+    }
+    else if (stage < 20 || !FinalBattlesReady())
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP) != 0)
+            gSpecialVar_Result = TRUE;
+}
+
+void Special_FriendsStoryGetPendingLoss(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady()
+        ? ReadBits(FRIENDS_STORY_LOSS_FIRST, FRIENDS_STORY_LOSS_BITS) : 0;
+}
+
+void Special_FriendsStoryClearPendingLoss(void)
+{
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    if (FriendsStory_IsReady())
+        WriteBits(FRIENDS_STORY_LOSS_FIRST, FRIENDS_STORY_LOSS_BITS, 0);
+    gSpecialVar_Result = FALSE;
+}
+
+void Special_FriendsStoryGetInvitation(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = FriendsStory_IsReady() && FlagGet(FLAG_FRIENDS_FAREWELL_INVITED);
+}
+
+void Special_FriendsStoryMarkInvitation(void)
+{
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    gSpecialVar_Result = Here(21);
+    if (gSpecialVar_Result)
+        FlagSet(FLAG_FRIENDS_FAREWELL_INVITED);
+}
+
+void Special_FriendsStoryInvitation(void)
+{
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    gSpecialVar_Result = Here(21) && !FlagGet(FLAG_FRIENDS_FAREWELL_INVITED);
+    if (gSpecialVar_Result)
+        FlagSet(FLAG_FRIENDS_FAREWELL_INVITED);
+}
+
+void Special_FriendsStoryCompleteDeparture(void)
+{
+    Script_RequestEffects(SCREFF_V1 | SCREFF_SAVE);
+    gSpecialVar_Result = Here(21) && FlagGet(FLAG_FRIENDS_FAREWELL_INVITED);
+    if (gSpecialVar_Result)
+        FlagSet(FLAG_FRIENDS_DEPARTED);
+}
+
+void Special_FriendsStoryIsReunionReady(void)
+{
+    Script_RequestEffects(SCREFF_V1);
+    gSpecialVar_Result = Here(22);
+}
+#endif
diff --git a/src/friends_visuals.c b/src/friends_visuals.c
new file mode 100644
index 0000000000000000000000000000000000000000..fe1c6365cf410b54a36ea89d8a8d64b9090e18c5
--- /dev/null
+++ b/src/friends_visuals.c
@@ -0,0 +1,307 @@
+#include "global.h"
+
+#ifdef FIRERED
+#include "friends_visuals.h"
+#include "bg.h"
+#include "decompress.h"
+#include "malloc.h"
+#include "menu.h"
+#include "palette.h"
+#include "task.h"
+#include "tilesets.h"
+#include "window.h"
+#include "constants/rgb.h"
+
+// Facility is a pinned native art donor, but its world-map Tileset descriptor
+// is not selected by the FireRed build. Register only the immutable visual
+// inputs here; this record never becomes a playable map or changes a tileset.
+static const u32 sFriendsFacilityTiles[] = INCBIN_U32("data/tilesets/secondary/facility/tiles.4bpp.fastSmol");
+static const u16 sFriendsFacilityMetatiles[] = INCBIN_U16("data/tilesets/secondary/facility/metatiles.bin");
+static const u16 sFriendsFacilityPalettes[][16] = {
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/00.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/01.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/02.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/03.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/04.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/05.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/06.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/07.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/08.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/09.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/10.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/11.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/12.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/13.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/14.gbapal"),
+    INCBIN_U16("data/tilesets/secondary/facility/palettes/15.gbapal"),
+};
+static const struct Tileset sFriendsFacility = {
+    .isCompressed = TRUE,
+    .isSecondary = TRUE,
+    .tiles = sFriendsFacilityTiles,
+    .palettes = sFriendsFacilityPalettes,
+    .metatiles = sFriendsFacilityMetatiles,
+};
+
+// Pinned Emerald Facility furniture, not an invented substitute: the three
+// actual blue sofa seats in Devon's president's office, with its wall/window
+// and floor. The television is the original Building TV metatile2. These
+// donor IDs use Emerald's512-tile partition, independently of the active map.
+// All source art stays unchanged. A blue-gray reflected view uses one UI
+// palette and cannot recolor any of the13 map palettes or OBJ actor palettes.
+#define DONOR_SECONDARY_FIRST 512
+#define DONOR_PALETTES_PRIMARY 6
+#define HOME_ROOM_W 6
+#define HOME_ROOM_H 4
+#define HOME_WINDOW_W 13
+#define HOME_WINDOW_H 9
+#define HOME_WINDOW_LEFT 16
+#define HOME_WINDOW_TOP 0
+#define HOME_WINDOW_BASE 100
+#define HOME_PALETTE 13
+#define HOME_WINDOW_TILES (HOME_WINDOW_W * HOME_WINDOW_H)
+
+static const u16 sHomeRoom[HOME_ROOM_H][HOME_ROOM_W] = {
+    {0x388, 0x389, 0x388, 0x389, 0x388, 0x389},
+    {0x390, 0x391, 0x349, 0x34A, 0x34B, 0x391},
+    {0x380, 0x380, 0x351, 0x352, 0x353, 0x380},
+    {0x380, 0x380, 0x380, 0x380, 0x380, 0x380},
+};
+
+static const struct WindowTemplate sHomeWindow = {
+    .bg = 0,
+    .tilemapLeft = HOME_WINDOW_LEFT,
+    .tilemapTop = HOME_WINDOW_TOP,
+    .width = HOME_WINDOW_W,
+    .height = HOME_WINDOW_H,
+    .paletteNum = HOME_PALETTE,
+    .baseBlock = HOME_WINDOW_BASE,
+};
+
+struct HomeView
+{
+    u8 windowId;
+    u8 taskId;
+    u8 mapGroup;
+    u8 mapNum;
+    u8 *windowPixels;
+    u16 oldPalette[16];
+    u16 oldFadedPalette[16];
+    u16 oldTilemap[HOME_WINDOW_TILES];
+};
+
+static EWRAM_DATA struct HomeView *sHomeView = NULL;
+
+static bool8 WindowAreaFree(void)
+{
+    u32 i;
+    for (i = 0; i < WINDOWS_MAX; i++)
+    {
+        const struct Window *win = &gWindows[i];
+        const struct WindowTemplate *t = &win->window;
+        if (win->tileData == NULL)
+            continue;
+        if (t->paletteNum == HOME_PALETTE)
+            return FALSE;
+        if (t->bg != 0)
+            continue;
+        // Both the screen rectangle and character-data range must be free.
+        if ((t->baseBlock < HOME_WINDOW_BASE + HOME_WINDOW_TILES
+          && t->baseBlock + t->width * t->height > HOME_WINDOW_BASE)
+         || (t->tilemapLeft < HOME_WINDOW_LEFT + HOME_WINDOW_W
+          && t->tilemapLeft + t->width > HOME_WINDOW_LEFT
+          && t->tilemapTop < HOME_WINDOW_TOP + HOME_WINDOW_H
+          && t->tilemapTop + t->height > HOME_WINDOW_TOP))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static void CopyViewTilemap(u16 *saved, bool8 restore)
+{
+    u32 y;
+    u16 *map = GetBgTilemapBuffer(0);
+    for (y = 0; y < HOME_WINDOW_H; y++)
+    {
+        u16 *row = map + (HOME_WINDOW_TOP + y) * 32 + HOME_WINDOW_LEFT;
+        if (restore)
+            CpuCopy16(saved + y * HOME_WINDOW_W, row, HOME_WINDOW_W * 2);
+        else
+            CpuCopy16(row, saved + y * HOME_WINDOW_W, HOME_WINDOW_W * 2);
+    }
+}
+
+static u8 ReflectedColor(u16 rgb)
+{
+    u32 r = rgb & 31;
+    u32 g = (rgb >> 5) & 31;
+    u32 b = (rgb >> 10) & 31;
+    // Twelve ordered shades2..13, leaving distinct colors for the rim.
+    return 2 + ((r * 3 + g * 6 + b) * 11 + 155) / 310;
+}
+
+static void PutViewPixel(u32 x, u32 y, u8 color)
+{
+    u32 tile = (y / 8) * HOME_WINDOW_W + x / 8;
+    u32 offset = tile * 32 + (y & 7) * 4 + ((x & 7) / 2);
+    u8 *pixel = sHomeView->windowPixels + offset;
+    if (x & 1)
+        *pixel = (*pixel & 0x0F) | (color << 4);
+    else
+        *pixel = (*pixel & 0xF0) | color;
+}
+
+static void DrawDonorMetatile(const u8 *tiles, bool8 facility, u16 metatile, u32 destX, u32 destY)
+{
+    const struct Tileset *donor = facility ? &sFriendsFacility : &gTileset_Building;
+    const u16 *parts = donor->metatiles + (facility ? metatile - DONOR_SECONDARY_FIRST : metatile) * 8;
+    u32 layer, quarter, x, y;
+    for (layer = 0; layer < 2; layer++)
+    {
+        for (quarter = 0; quarter < 4; quarter++)
+        {
+            u16 word = parts[layer * 4 + quarter];
+            u32 tile = word & 0x3FF;
+            u32 pal = word >> 12;
+            const u16 *palette;
+            const u8 *pixels;
+            if (facility)
+            {
+                // Audited donor entries refer to primary tile0 only for
+                // transparent upper quadrants; no primary scratch is needed.
+                if (tile < DONOR_SECONDARY_FIRST)
+                    continue;
+                tile -= DONOR_SECONDARY_FIRST;
+            }
+            palette = (pal < DONOR_PALETTES_PRIMARY ? &gTileset_Building : &sFriendsFacility)->palettes[pal];
+            pixels = tiles + tile * 32;
+            for (y = 0; y < 8; y++)
+            {
+                for (x = 0; x < 8; x++)
+                {
+                    u32 sourceX = word & 0x400 ? 7 - x : x;
+                    u32 sourceY = word & 0x800 ? 7 - y : y;
+                    u8 index = (pixels[sourceY * 4 + sourceX / 2] >> (4 * (sourceX & 1))) & 15;
+                    if (layer != 0 && index == 0)
+                        continue;
+                    PutViewPixel(destX + (quarter & 1) * 8 + x,
+                        destY + (quarter / 2) * 8 + y, ReflectedColor(palette[index]));
+                }
+            }
+        }
+    }
+}
+
+static void Task_HomeRim(u8 taskId)
+{
+    static const u16 colors[] = {
+        RGB(15, 7, 24), RGB(20, 11, 29), RGB(25, 18, 31), RGB(20, 11, 29),
+    };
+    if (sHomeView == NULL || sHomeView->taskId != taskId)
+    {
+        DestroyTask(taskId);
+        return;
+    }
+    if (gPaletteFade.active)
+        return;
+    gTasks[taskId].data[0] = (gTasks[taskId].data[0] + 1) & 31;
+    if ((gTasks[taskId].data[0] & 7) == 0)
+        LoadPalette(&colors[(gTasks[taskId].data[0] >> 3) & 3], HOME_PALETTE * 16 + 14, 2);
+}
+
+bool8 FriendsVisuals_ShowHome(void)
+{
+    u8 *scratch;
+    u32 maxSize, x, y;
+    u16 palette[16];
+    struct HomeView *view;
+    if (sHomeView != NULL)
+        return TRUE;
+    if (gSaveBlock1Ptr == NULL || GetBgTilemapBuffer(0) == NULL || !WindowAreaFree())
+        return FALSE;
+    maxSize = GetDecompressedDataSize(sFriendsFacility.tiles);
+    if (maxSize < GetDecompressedDataSize(gTileset_Building.tiles))
+        maxSize = GetDecompressedDataSize(gTileset_Building.tiles);
+    scratch = Alloc(maxSize);
+    view = AllocZeroed(sizeof(*view));
+    if (scratch == NULL || view == NULL)
+    {
+        if (scratch != NULL)
+            Free(scratch);
+        if (view != NULL)
+            Free(view);
+        return FALSE;
+    }
+    view->windowId = AddWindow(&sHomeWindow);
+    if (view->windowId == WINDOW_NONE)
+    {
+        Free(scratch);
+        Free(view);
+        return FALSE;
+    }
+    view->taskId = TASK_NONE;
+    view->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    view->mapNum = gSaveBlock1Ptr->location.mapNum;
+    view->windowPixels = (u8 *)GetWindowAttribute(view->windowId, WINDOW_TILE_DATA);
+    CpuCopy16(&gPlttBufferUnfaded[HOME_PALETTE * 16], view->oldPalette, 32);
+    CpuCopy16(&gPlttBufferFaded[HOME_PALETTE * 16], view->oldFadedPalette, 32);
+    CopyViewTilemap(view->oldTilemap, FALSE);
+    sHomeView = view;
+
+    palette[0] = RGB(0, 0, 0);
+    palette[1] = RGB(7, 2, 13);
+    for (x = 0; x < 12; x++)
+        palette[x + 2] = RGB(2 + x * 2, 3 + x * 2, 7 + x * 2);
+    palette[14] = RGB(20, 11, 29);
+    palette[15] = RGB(29, 26, 31);
+    LoadPalette(palette, HOME_PALETTE * 16, sizeof(palette));
+    FillWindowPixelBuffer(view->windowId, PIXEL_FILL(1));
+    FillWindowPixelRect(view->windowId, PIXEL_FILL(14), 2, 2, 100, 68);
+    DecompressDataWithHeaderWram(sFriendsFacility.tiles, scratch);
+    for (y = 0; y < HOME_ROOM_H; y++)
+        for (x = 0; x < HOME_ROOM_W; x++)
+            DrawDonorMetatile(scratch, TRUE, sHomeRoom[y][x], 4 + x * 16, 4 + y * 16);
+    DecompressDataWithHeaderWram(gTileset_Building.tiles, scratch);
+    DrawDonorMetatile(scratch, FALSE, 2, 12, 28);
+    Free(scratch);
+    PutWindowTilemap(view->windowId);
+    CopyWindowToVram(view->windowId, COPYWIN_FULL);
+    if (GetTaskCount() < NUM_TASKS)
+        view->taskId = CreateTask(Task_HomeRim, 80);
+    return TRUE;
+}
+
+void FriendsVisuals_HideHome(void)
+{
+    struct HomeView *view = sHomeView;
+    if (view == NULL)
+        return;
+    sHomeView = NULL;
+    if (view->taskId != TASK_NONE && gTasks[view->taskId].isActive
+     && gTasks[view->taskId].func == Task_HomeRim)
+        DestroyTask(view->taskId);
+    // A defensive stale-context exit must not clear a newly initialized map
+    // or an unrelated window if its numeric ID has since been reused.
+    if (gSaveBlock1Ptr != NULL
+     && view->mapGroup == gSaveBlock1Ptr->location.mapGroup
+     && view->mapNum == gSaveBlock1Ptr->location.mapNum
+     && gWindows[view->windowId].tileData == view->windowPixels
+     && gWindows[view->windowId].window.baseBlock == HOME_WINDOW_BASE)
+    {
+        if (GetBgTilemapBuffer(0) != NULL)
+        {
+            CopyViewTilemap(view->oldTilemap, TRUE);
+            ScheduleBgCopyTilemapToVram(0);
+        }
+        RemoveWindow(view->windowId);
+        LoadPalette(view->oldPalette, HOME_PALETTE * 16, 32);
+        CpuCopy16(view->oldFadedPalette, &gPlttBufferFaded[HOME_PALETTE * 16], 32);
+    }
+    Free(view);
+}
+
+bool8 FriendsVisuals_IsShowing(void)
+{
+    return sHomeView != NULL;
+}
+#endif

+  .2byte -1
+  .2byte -1
+ .else
+ .ifb \b
+  .byte \a
+  .2byte -1
+  .2byte -1
+ .else
+ .ifb \c
+  .byte (-1)
+  .2byte \a
+  .2byte \b
+ .else
+  .byte \a
+  .2byte \b
+  .2byte \c
+ .endif
+ .endif
+ .endif
+ .endm

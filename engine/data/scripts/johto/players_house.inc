	setvar VAR_0x8008, LOCALID_PLAYERS_HOUSE_2F_MOM
	addobject VAR_0x8008
	applymovement VAR_0x8008, J_PlayersHouse_2F_Movement_MomEntersMale
	waitmovement 0
	applymovement LOCALID_PLAYER, J_Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	msgbox J_PlayersHouse_2F_Text_HowDoYouLikeYourRoom, MSGBOX_DEFAULT
	closemessage
	applymovement VAR_0x8008, J_PlayersHouse_2F_Movement_MomExitsMale

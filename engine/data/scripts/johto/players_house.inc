J_PlayersHouse_2F_EventScript_BlockStairsUntilClockIsSet::
	setvar JOHTO_VAR_LITTLEROOT_INTRO_STATE, 5
	return

J_PlayersHouse_1F_EventScript_EnterHouseMovingIn::
	msgbox J_PlayersHouse_1F_Text_IsntItNiceInHere, MSGBOX_DEFAULT
	applymovement VAR_0x8004, J_Common_Movement_FacePlayer
	waitmovement 0
	call_if_eq VAR_0x8005, MALE, J_PlayersHouse_1F_EventScript_MomFacePlayerMovingInMale
	call_if_eq VAR_0x8005, FEMALE, J_PlayersHouse_1F_EventScript_MomFacePlayerMovingInFemale
	msgbox J_PlayersHouse_1F_Text_MoversPokemonGoSetClock, MSGBOX_DEFAULT
	closemessage
	setvar JOHTO_VAR_LITTLEROOT_INTRO_STATE, 4
	applymovement LOCALID_PLAYER, J_PlayersHouse_1F_Movement_PlayerWalkIn
	applymovement VAR_0x8004, J_Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	releaseall
	end

J_PlayersHouse_1F_EventScript_MomFacePlayerMovingInMale::
	applymovement LOCALID_PLAYER, J_Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	return

J_PlayersHouse_1F_EventScript_MomFacePlayerMovingInFemale::
	applymovement LOCALID_PLAYER, J_Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	return

J_PlayersHouse_1F_Movement_PlayerWalkIn:

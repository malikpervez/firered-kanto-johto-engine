J_LittlerootTown_BrendansHouse_2F_EventScript_WallClock::
	lockall
	setvar VAR_0x8004, MALE
	goto_if_unset JOHTO_FLAG_SET_WALL_CLOCK, J_PlayersHouse_2F_EventScript_WallClock
	msgbox J_PlayersHouse_2F_Text_ClockChange, MSGBOX_DEFAULT
	goto J_PlayersHouse_2F_EventScript_WallClock
	end

J_LittlerootTown_MaysHouse_2F_EventScript_WallClock::
	lockall
	setvar VAR_0x8004, FEMALE
	goto_if_unset JOHTO_FLAG_SET_WALL_CLOCK, J_PlayersHouse_2F_EventScript_WallClock
	msgbox J_PlayersHouse_2F_Text_ClockChange, MSGBOX_DEFAULT
	goto J_PlayersHouse_2F_EventScript_WallClock
	end

J_PlayersHouse_2F_Text_ClockChange:
	.string "Press the R Button to set the\n"
	.string "clock when looking at the time.$"

J_PlayersHouse_2F_EventScript_WallClock::
	goto_if_set JOHTO_FLAG_SET_WALL_CLOCK, J_PlayersHouse_2F_EventScript_CheckWallClock
	msgbox J_PlayersHouse_2F_Text_ClockIsStopped, MSGBOX_DEFAULT
	call J_PlayersHouse_2F_EventScript_SetWallClock
	delay 30
	setvar JOHTO_VAR_LITTLEROOT_INTRO_STATE, 6
	setflag JOHTO_FLAG_SET_WALL_CLOCK
	setflag FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_1
	setflag FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_2
	checkplayergender
	call_if_eq VAR_RESULT, MALE, J_PlayersHouse_2F_EventScript_MomComesUpstairsMale
	call_if_eq VAR_RESULT, FEMALE, J_PlayersHouse_2F_EventScript_MomComesUpstairsFemale
	playse SE_EXIT
	removeobject VAR_0x8008
	releaseall
	end

